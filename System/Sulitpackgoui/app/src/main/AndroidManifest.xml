<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sulitpackgoui">


        <!-- SPLASH SCREEN -->

        <activity
            android:name=".uic.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Sulitpackgoui">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- LOGIN -->

        <activity
            android:name=".uic.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui"
            android:windowSoftInputMode="adjustResize" />


        <!-- SIGN UP -->

        <activity
            android:name=".uic.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui"
            android:windowSoftInputMode="adjustResize" />


        <!-- CUSTOMER -->

        <activity
            android:name=".uic.customer.CustomerHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerLocationPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerPackageActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".uic.customer.CustomerReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerConfirmationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerTrackActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerOrdersActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.customer.CustomerEditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".uic.customer.CustomerChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui"
            android:windowSoftInputMode="adjustResize" />


        <!-- RIDER -->

        <activity
            android:name=".uic.rider.RiderHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.rider.RiderAvailableOrdersActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.rider.RiderOrderDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.rider.RiderActiveDeliveryActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.rider.RiderHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


        <activity
            android:name=".uic.rider.RiderProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sulitpackgoui" />


    </application>

</manifest>